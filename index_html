<script>
// Tab switching
function switchTab(name, btn) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('view-' + name).classList.add('active');
}

// Vote toggle
function toggleVote(header) {
  const body = header.nextElementSibling;
  const chevron = header.querySelector('.chevron');
  const isOpen = body.classList.contains('open');
  document.querySelectorAll('.vote-body.open').forEach(b => b.classList.remove('open'));
  document.querySelectorAll('.vote-header.open').forEach(h => h.classList.remove('open'));
  document.querySelectorAll('.chevron.open').forEach(c => c.classList.remove('open'));
  if (!isOpen) {
    body.classList.add('open');
    header.classList.add('open');
    chevron.classList.add('open');
  }
}

// Filter votes
function filterVotes() {
  const search = document.getElementById('vote-search').value.toLowerCase();
  const category = document.getElementById('vote-category').value;
  const result = document.getElementById('vote-result').value;
  const cards = document.querySelectorAll('.vote-card');
  let visible = 0;
  cards.forEach(card => {
    const text = (card.dataset.text || '').toLowerCase();
    const title = card.querySelector('.vote-title').textContent.toLowerCase();
    const matchSearch = !search || text.includes(search) || title.includes(search);
    const matchCat = category === 'all' || card.dataset.category === category;
    const matchResult = result === 'all' || card.dataset.result === result;
    const show = matchSearch && matchCat && matchResult;
    card.classList.toggle('hidden', !show);
    if (show) visible++;
  });
  document.getElementById('no-votes').style.display = visible === 0 ? 'block' : 'none';
  document.getElementById('vote-count').textContent = `${visible} vote${visible !== 1 ? 's' : ''}`;
}

// Filter MPs
let partyFilter = 'all';
function filterParty(party, btn) {
  document.querySelectorAll('.party-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  partyFilter = party;
  filterMPs();
}

function filterMPs() {
  const search = document.getElementById('mp-search').value.toLowerCase();
  const cards = document.querySelectorAll('.mp-card');
  let visible = 0;
  cards.forEach(card => {
    const name = (card.dataset.name || '').toLowerCase();
    const party = card.dataset.party || '';
    const matchSearch = !search || name.includes(search);
    const matchParty = partyFilter === 'all' || party === partyFilter;
    const show = matchSearch && matchParty;
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('no-mps').style.display = visible === 0 ? 'block' : 'none';
}

// Init
filterVotes();
</script>
